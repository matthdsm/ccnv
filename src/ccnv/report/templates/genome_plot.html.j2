<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }} - CCNV Genome Profile</title>
<script src="{{ plotly_cdn_url }}" charset="utf-8"></script>
<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #fff;
    color: #1e293b;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
    font-size: 13px;
  }
  .title {
    font-weight: 600;
    font-size: 14px;
    margin-right: 6px;
  }
  .grp {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  input[type="text"] {
    padding: 4px 8px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-size: 13px;
    width: 230px;
  }
  input[type="number"] {
    padding: 4px 6px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-size: 13px;
    width: 68px;
  }
  button {
    padding: 4px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    font-size: 13px;
    color: #1e293b;
  }
  button:hover {
    background: #f1f5f9;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    font-size: 12px;
    color: #475569;
  }
  .dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 4px;
  }
  .err {
    color: #dc2626;
    font-size: 12px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
  }
  .badge-warn {
    background: #fffbeb;
    border-color: #fde68a;
    color: #b45309;
  }
  .badge-alert {
    background: #fef2f2;
    border-color: #fecaca;
    color: #dc2626;
  }
  #plot {
    flex: 1;
    width: 100%;
    min-height: 0;
  }
</style>
</head>
<body>
<div class="bar">
  <span class="title">{{ title }}</span>
  <form id="search-form" class="grp" onsubmit="return false;">
    <input
      id="coord-input"
      type="text"
      placeholder="chr21:13.1m-46.7m, chr21, 21q22.11"
      aria-label="Genomic coordinates"
    >
    <button id="go-btn" type="submit">Go</button>
    <button id="reset-btn" type="button">Whole Genome</button>
    <span id="search-err" class="err"></span>
  </form>
  <div class="grp">
    <label for="z-input">|Z| &ge;</label>
    <input id="z-input" type="number" step="0.1" min="0">
  </div>
  <div class="grp">
    <label for="r-input">|Log2R| &ge;</label>
    <input id="r-input" type="number" step="0.05" min="0">
  </div>
  <div id="prenatal-badge" class="badge" style="display:none"></div>
  <div class="legend">
    <span><i class="dot" style="background:#c43c39"></i>Gain</span>
    <span><i class="dot" style="background:#3c8c5a"></i>Loss</span>
    <span><i class="dot" style="background:#64748b"></i>Neutral</span>
    <span id="disc-legend" style="display:none"><i class="dot" style="background:#9333ea"></i>Discordant</span>
  </div>
</div>
<div id="plot"></div>
<script id="ccnv-data" type="application/json">{{ payload_json | safe }}</script>
<script>
(() => {
  const D = JSON.parse(document.getElementById("ccnv-data").textContent);
  const b64 = (s, T) => {
    if (!s) return new T(0);
    const bin = atob(s);
    const u8 = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
    return new T(u8.buffer);
  };
  const binC = b64(D.bins.c, Uint16Array);
  const binS = b64(D.bins.s, Int32Array);
  const binE = b64(D.bins.e, Int32Array);
  const binR = b64(D.bins.r, Float32Array);
  const binZ = b64(D.bins.z, Float32Array);
  const N = D.n_bins;

  const offsets = new Float64Array(D.contigs.length);
  let totalLen = 0;
  const contigMap = new Map();
  const stripChr = s => s.toLowerCase().replace(/^chr/, "");
  for (let i = 0; i < D.contigs.length; i++) {
    offsets[i] = totalLen;
    totalLen += D.lengths[i];
    contigMap.set(D.contigs[i].toLowerCase(), i);
    contigMap.set(stripChr(D.contigs[i]), i);
  }
  if (totalLen <= 0) totalLen = 1;

  const binX = new Float64Array(N);
  const binHover = new Array(N);
  for (let i = 0; i < N; i++) {
    const ci = binC[i];
    binX[i] = offsets[ci] + 0.5 * (binS[i] + binE[i]);
    binHover[i] = `${D.contigs[ci]}:${binS[i].toLocaleString()}-${binE[i].toLocaleString()}<br>Log2R: ${binR[i].toFixed(3)} | Z: ${binZ[i].toFixed(2)}`;
  }

  const zInput = document.getElementById("z-input");
  const rInput = document.getElementById("r-input");
  zInput.value = D.z_thresh;
  rInput.value = D.r_thresh;

  const badgeEl = document.getElementById("prenatal-badge");
  const discLegend = document.getElementById("disc-legend");
  if (D.prenatal && badgeEl) {
    const p = D.prenatal;
    if (p.is_aneuploid) {
      badgeEl.className = "badge badge-alert";
    } else if (p.low_ff_warning) {
      badgeEl.className = "badge badge-warn";
    } else {
      badgeEl.className = "badge";
    }
    const ffPct = (p.active_ff * 100).toFixed(1);
    const ffyStr = p.ffy !== null && p.ffy !== undefined ? `${(p.ffy * 100).toFixed(1)}%` : "N/A";
    const prefStr = p.preface !== null && p.preface !== undefined ? `${(p.preface * 100).toFixed(1)}%` : "N/A";
    const ffxStr = p.ffx !== null && p.ffx !== undefined ? `${(p.ffx * 100).toFixed(1)}%` : "N/A";
    badgeEl.innerHTML = `<span><strong>Fetal Sex:</strong> ${p.fetal_sex}</span>` +
      `<span>|</span><span><strong>Active FF:</strong> ${ffPct}% (${p.active_ff_source})</span>` +
      `<span>|</span><span><strong>FF:</strong> ${ffyStr} / ${prefStr} / ${ffxStr}</span>` +
      `<span>|</span><span><strong>SCA:</strong> ${p.sca_call}</span>`;
    badgeEl.style.display = "inline-flex";
    if (discLegend) discLegend.style.display = "inline";
  }

  const classify = (r, z, zT, rT) => {
    if (Math.abs(z) >= zT && Math.abs(r) >= rT) {
      if (r > 0 && z >= 0) return 1;
      if (r < 0 && z <= 0) return -1;
    }
    return 0;
  };

  const hasCyto = D.cytobands && D.cytobands.length > 0;
  const stainColor = {
    gneg: "#ffffff",
    gpos25: "#d9d9d9",
    gpos33: "#bfbfbf",
    gpos50: "#969696",
    gpos66: "#737373",
    gpos75: "#525252",
    gpos100: "#1e293b",
    acen: "#dc2626",
    gvar: "#cbd5e1",
    stalk: "#94a3b8"
  };

  const baseShapes = [];
  const tickVals = [];
  const tickText = [];
  for (let i = 0; i < D.contigs.length; i++) {
    const x0 = offsets[i];
    const x1 = x0 + D.lengths[i];
    tickVals.push(0.5 * (x0 + x1));
    tickText.push(D.contigs[i]);
    if (i % 2 === 1) {
      baseShapes.push({
        type: "rect",
        xref: "x",
        yref: "y",
        x0,
        x1,
        y0: -2.5,
        y1: 2.5,
        fillcolor: "#f8fafc",
        line: { width: 0 },
        layer: "below"
      });
    }
    if (i > 0) {
      baseShapes.push({
        type: "line",
        xref: "x",
        yref: "paper",
        x0,
        x1: x0,
        y0: 0,
        y1: 1,
        line: { color: "#e2e8f0", width: 1 },
        layer: "below"
      });
    }
  }

  if (D.prenatal && typeof D.prenatal.active_ff === "number" && D.prenatal.active_ff > 0) {
    const aff = D.prenatal.active_ff;
    const posRef = Math.log2(1 + 0.5 * aff);
    const negRef = Math.log2(Math.max(1e-4, 1 - 0.5 * aff));
    for (const yVal of [posRef, negRef]) {
      baseShapes.push({
        type: "line",
        xref: "paper",
        yref: "y",
        x0: 0,
        x1: 1,
        y0: yVal,
        y1: yVal,
        line: { color: "#9333ea", width: 1.5, dash: "dash" },
        layer: "below"
      });
    }
  }

  const cytoX = [];
  const cytoY = [];
  const cytoText = [];
  if (hasCyto) {
    for (const [ci, s, e, name, stain] of D.cytobands) {
      const x0 = offsets[ci] + s;
      const x1 = offsets[ci] + e;
      baseShapes.push({
        type: "rect",
        xref: "x",
        yref: "y2",
        x0,
        x1,
        y0: 0.15,
        y1: 0.85,
        fillcolor: stainColor[stain] || "#e2e8f0",
        line: { color: "#64748b", width: 0.5 },
        layer: "above"
      });
      cytoX.push(0.5 * (x0 + x1));
      cytoY.push(0.5);
      cytoText.push(`${D.contigs[ci]}${name} (${s.toLocaleString()}-${e.toLocaleString()}, ${stain})`);
    }
  }

  const Y_LIM = 2.5;
  const clampY = v => Math.max(-Y_LIM, Math.min(Y_LIM, v));

  const mkScatter = (name, x, y, text, color, size, op) => ({
    type: "scattergl",
    mode: "markers",
    name,
    x,
    y,
    text,
    hoverinfo: "text",
    marker: { color, size, opacity: op },
    showlegend: false
  });
  const mkLines = (name, x, y, text, color, width) => ({
    type: "scatter",
    mode: "lines",
    name,
    x,
    y,
    text,
    hoverinfo: "text",
    line: { color, width },
    cliponaxis: false,
    showlegend: false
  });

  const buildTraces = (zT, rT) => {
    const binBuckets = { 0: { x: [], y: [], t: [] }, 1: { x: [], y: [], t: [] }, [-1]: { x: [], y: [], t: [] } };
    for (let i = 0; i < N; i++) {
      const b = binBuckets[classify(binR[i], binZ[i], zT, rT)] || binBuckets[0];
      b.x.push(binX[i]);
      b.y.push(clampY(binR[i]));
      b.t.push(binHover[i]);
    }

    const segBuckets = {
      neutral: { x: [], y: [], t: [] },
      gain: { x: [], y: [], t: [] },
      loss: { x: [], y: [], t: [] },
      disc: { x: [], y: [], t: [] }
    };
    const pushSeg = (b, x0, x1, y, h) => {
      b.x.push(x0, x1, null);
      b.y.push(y, y, null);
      b.t.push(h, h, "");
    };

    for (const seg of D.segments) {
      const ci = seg[0];
      const s = seg[1];
      const e = seg[2];
      const r = seg[3];
      const z = seg[4];
      const bc = seg[5];
      const isDisc = Boolean(seg[6]);
      const impliedFF = seg[7];
      const expR = seg[8];
      const discReason = seg[9];

      const c = classify(r, z, zT, rT);
      const x0 = offsets[ci] + s;
      const x1 = offsets[ci] + e;
      const yClip = clampY(r);
      let h = `${D.contigs[ci]}:${s.toLocaleString()}-${e.toLocaleString()} (${bc} bins)<br>Segment Log2R: ${r.toFixed(3)} | Z: ${z.toFixed(2)}`;
      if (isDisc) {
        h += `<br>Discordant: ${discReason || "YES"}`;
        if (expR !== null && expR !== undefined) h += ` | Expected: ${Number(expR).toFixed(3)}`;
        if (impliedFF !== null && impliedFF !== undefined) h += ` | Implied FF: ${(Number(impliedFF) * 100).toFixed(1)}%`;
        pushSeg(segBuckets.disc, x0, x1, yClip, h);
      } else if (c === 1) {
        pushSeg(segBuckets.gain, x0, x1, yClip, h);
      } else if (c === -1) {
        pushSeg(segBuckets.loss, x0, x1, yClip, h);
      } else {
        pushSeg(segBuckets.neutral, x0, x1, yClip, h);
      }
    }

    const traces = [
      mkScatter("Bins (Neutral)", binBuckets[0].x, binBuckets[0].y, binBuckets[0].t, "#94a3b8", 3.5, 0.7),
      mkScatter("Bins (Gain)", binBuckets[1].x, binBuckets[1].y, binBuckets[1].t, "#e11d48", 4.5, 0.85),
      mkScatter("Bins (Loss)", binBuckets[-1].x, binBuckets[-1].y, binBuckets[-1].t, "#16a34a", 4.5, 0.85),
      mkLines("Segments (Neutral)", segBuckets.neutral.x, segBuckets.neutral.y, segBuckets.neutral.t, "#1e293b", 2.2),
      mkLines("Segments (Gain)", segBuckets.gain.x, segBuckets.gain.y, segBuckets.gain.t, "#c43c39", 3),
      mkLines("Segments (Loss)", segBuckets.loss.x, segBuckets.loss.y, segBuckets.loss.t, "#3c8c5a", 3),
      {
        type: "scatter",
        mode: "lines+markers",
        name: "Segments (Discordant)",
        x: segBuckets.disc.x,
        y: segBuckets.disc.y,
        text: segBuckets.disc.t,
        hoverinfo: "text",
        line: { color: "#9333ea", width: 6.0 },
        marker: { symbol: "diamond", size: 7, color: "#9333ea" },
        cliponaxis: false,
        showlegend: false
      }
    ];
    if (hasCyto) {
      traces.push({
        type: "scatter",
        mode: "markers",
        yaxis: "y2",
        x: cytoX,
        y: cytoY,
        text: cytoText,
        hoverinfo: "text",
        marker: { size: 8, opacity: 0 },
        showlegend: false
      });
    }
    return traces;
  };

  const layout = {
    margin: { l: 55, r: 20, t: 12, b: 55 },
    dragmode: "pan",
    hovermode: "closest",
    shapes: baseShapes,
    xaxis: {
      range: [0, totalLen],
      tickvals: tickVals,
      ticktext: tickText,
      tickangle: 45,
      zeroline: false,
      showgrid: false,
      title: { text: "Chromosome / Genomic Position", standoff: 10 }
    },
    yaxis: {
      domain: hasCyto ? [0, 0.90] : [0, 1],
      range: [-Y_LIM, Y_LIM],
      fixedrange: true,
      title: "Log2 Ratio",
      zeroline: true,
      zerolinecolor: "#64748b",
      gridcolor: "#f1f5f9"
    }
  };
  if (hasCyto) {
    layout.yaxis2 = {
      domain: [0.92, 1],
      range: [0, 1],
      fixedrange: true,
      showticklabels: false,
      showgrid: false,
      zeroline: false,
      title: { text: "Band", font: { size: 10 } }
    };
  }

  const plotEl = document.getElementById("plot");
  const config = { responsive: true, scrollZoom: true, displaylogo: false };
  Plotly.newPlot(plotEl, buildTraces(D.z_thresh, D.r_thresh), layout, config);

  const updateThresholds = () => {
    const zT = Math.max(0, parseFloat(zInput.value) || 0);
    const rT = Math.max(0, parseFloat(rInput.value) || 0);
    layout.xaxis.range = plotEl.layout.xaxis.range;
    Plotly.react(plotEl, buildTraces(zT, rT), layout, config);
  };
  zInput.addEventListener("input", updateThresholds);
  rInput.addEventListener("input", updateThresholds);

  const parseBp = s => {
    const clean = s.replace(/,/g, "").trim().toLowerCase();
    const m = clean.match(/^(\d+(?:\.\d+)?)(k|kb|m|mb)?$/);
    if (!m) return NaN;
    const v = parseFloat(m[1]);
    const u = m[2] || "";
    if (u.startsWith("k")) return v * 1e3;
    if (u.startsWith("m")) return v * 1e6;
    return v;
  };

  const errEl = document.getElementById("search-err");
  const zoomRange = (x0, x1) => {
    errEl.textContent = "";
    Plotly.relayout(plotEl, { "xaxis.range": [x0, x1] });
  };

  document.getElementById("search-form").addEventListener("submit", () => {
    const q = document.getElementById("coord-input").value.trim();
    if (!q) {
      zoomRange(0, totalLen);
      return;
    }
    const regionMatch = q.match(/^([^:\s]+)(?:[:\s]+([^-\s]+)(?:[-\s]+(\S+))?)?$/);
    if (regionMatch) {
      const cKey = regionMatch[1].toLowerCase();
      const ci = contigMap.has(cKey)
        ? contigMap.get(cKey)
        : contigMap.get(stripChr(cKey));
      if (ci !== undefined) {
        const cStart = offsets[ci];
        const cLen = D.lengths[ci];
        if (!regionMatch[2]) {
          zoomRange(cStart, cStart + cLen);
          return;
        }
        const s = parseBp(regionMatch[2]);
        const e = regionMatch[3] ? parseBp(regionMatch[3]) : s + 100000;
        if (!Number.isNaN(s) && !Number.isNaN(e) && e > s) {
          zoomRange(cStart + Math.max(0, s), cStart + Math.min(cLen, e));
          return;
        }
      }
    }
    if (hasCyto) {
      const qLow = stripChr(q);
      const matches = D.cytobands.filter(([ci, s, e, name]) => {
        const full = stripChr(D.contigs[ci]) + name.toLowerCase();
        return full.startsWith(qLow) || name.toLowerCase() === qLow;
      });
      if (matches.length > 0) {
        const ci = matches[0][0];
        const minS = Math.min(...matches.map(m => m[1]));
        const maxE = Math.max(...matches.map(m => m[2]));
        zoomRange(offsets[ci] + minS, offsets[ci] + maxE);
        return;
      }
    }
    errEl.textContent = "Region not found";
  });

  document.getElementById("reset-btn").addEventListener("click", () => {
    document.getElementById("coord-input").value = "";
    Plotly.relayout(plotEl, { "xaxis.range": [0, totalLen] });
    errEl.textContent = "";
  });
})();
</script>
</body>
</html>
