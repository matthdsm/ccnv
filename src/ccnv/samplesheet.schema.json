{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Samplesheet",
  "description": "JSON schema for validating ccnv cohort samplesheets.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "filepath"
    ],
    "properties": {
      "filepath": {
        "type": "string",
        "minLength": 1
      },
      "sex": {
        "enum": [
          "M",
          "F",
          null
        ]
      },
      "ff": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "additionalProperties": false
  }
}
